# MongoDB Atlas server-only connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Auth.js secret: generate with `npx auth secret`
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Fixed admin credentials; never commit the plaintext password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash
